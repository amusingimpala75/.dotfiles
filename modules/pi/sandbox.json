{
  "filesystem": {
    "allowRead": [
      "/nix/store",
      ".",
      "~/.config",
      "~/.local",
      "~/Library",
      "~/.dotfiles/modules/pi/skills",
      "~/.cache/nix",
      "~/.nix-defexpr"
    ]
  },
  "network": {
    "allowAllUnixSockets": true,
    "allowedDomains": [
      "npmjs.org",
      "*.npmjs.org",
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "pypi.org",
      "*.pypi.org",
      "github.com",
      "*.github.com",
      "api.github.com",
      "raw.githubusercontent.com",

      "crates.io",
      "*.crates.io"
    ]
  }
}
